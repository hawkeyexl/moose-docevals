{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moose:config:0.1",
  "title": "moose config",
  "description": "Shared configuration for the moose family of documentation tools. Each tool reads its own top-level namespace; unknown keys belong to sibling tools and are ignored here. Every key is kebab-case — the same spelling the frontmatter vocabulary uses, so a field means one thing wherever it is written.",
  "type": "object",
  "properties": {
    "docevals": { "$ref": "#/$defs/docevalsConfig" }
  },
  "additionalProperties": true,
  "$defs": {
    "docevalsConfig": {
      "type": "object",
      "properties": {
        "version": { "const": 1 },
        "files": {
          "type": "object",
          "properties": {
            "include": { "type": "array", "items": { "type": "string" } },
            "exclude": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "defaults": {
          "type": "object",
          "properties": {
            "suite": { "type": ["string", "null"] },
            "fail-fast": { "type": "boolean" },
            "concurrency": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "provider": {
          "type": "object",
          "properties": {
            "default": { "enum": ["anthropic", "openai", "claude-cli"] },
            "anthropic": {
              "type": "object",
              "properties": {
                "model": { "type": "string" },
                "api-key-env": { "type": "string" },
                "pricing": { "$ref": "#/$defs/pricing" }
              },
              "additionalProperties": false
            },
            "openai": {
              "type": "object",
              "properties": {
                "base-url": { "type": "string" },
                "model": { "type": "string" },
                "api-key-env": { "type": "string" },
                "pricing": { "$ref": "#/$defs/pricing" }
              },
              "additionalProperties": false
            },
            "claude-cli": {
              "type": "object",
              "properties": {
                "model": { "type": "string" },
                "command": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "judge": {
          "type": "object",
          "properties": {
            "ensemble-runs": { "type": "integer", "minimum": 1 },
            "temperature": { "type": "number", "minimum": 0 },
            "zones": {
              "type": "object",
              "properties": {
                "auto-pass": { "type": "number", "minimum": 0, "maximum": 1 },
                "auto-fail": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            },
            "false-positive-alert": { "type": "number", "minimum": 0, "maximum": 1 },
            "cache-dir": { "type": "string" },
            "max-cost-usd": { "type": ["number", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "scripts": {
          "type": "object",
          "properties": {
            "dir": { "type": "string" },
            "config-dir": { "type": "string" },
            "allow-frontmatter-commands": { "type": "boolean" },
            "timeout-ms": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "fill": {
          "type": "object",
          "properties": {
            "confidence-threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "max-evals-per-page": { "type": "integer", "minimum": 1 },
            "temperature": { "type": "number", "minimum": 0 },
            "cache-dir": { "type": "string" },
            "max-cost-usd": { "type": ["number", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "evals": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "additionalProperties": { "$ref": "#/$defs/evalDef" },
          "description": "The central library of named evals. The map key is the eval's id — the same id a page's `use:` reference names."
        },
        "suites": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "additionalProperties": { "$ref": "#/$defs/suiteDef" }
        }
      },
      "required": ["version"],
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "properties": {
        "input-per-mtok": { "type": "number", "minimum": 0 },
        "output-per-mtok": { "type": "number", "minimum": 0 }
      },
      "required": ["input-per-mtok", "output-per-mtok"],
      "additionalProperties": false,
      "description": "Price override for this provider. Both sides are required: completing a half-filled override with a zero would price those tokens as free, under-reporting cost and letting max-cost-usd ride past a ceiling it exists to enforce."
    },
    "evalDef": {
      "type": "object",
      "properties": {
        "assertion": { "type": "string", "minLength": 1 },
        "type": { "enum": ["capability", "regression"] },
        "grader": {
          "type": "string",
          "pattern": "^(ai|command|human|tool:[a-z0-9][a-z0-9-]*)$"
        },
        "provider": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "examples": {
          "type": "object",
          "properties": {
            "pass": { "$ref": "#/$defs/anchorList" },
            "fail": { "$ref": "#/$defs/anchorList" }
          },
          "additionalProperties": false
        },
        "command": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "success-exit-codes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" }
        },
        "timeout-ms": { "type": "integer", "minimum": 1 },
        "generated-assertion-hash": { "type": "string" },
        "options": { "type": "object" },
        "severity": { "enum": ["error", "warning", "info"] },
        "severity-map": {
          "type": "object",
          "additionalProperties": { "enum": ["error", "warning", "info"] }
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "generated-assertion-hash": ["command"]
      },
      "allOf": [
        {
          "if": {
            "properties": { "grader": { "const": "ai" } },
            "required": ["grader"]
          },
          "then": { "required": ["assertion"] }
        },
        {
          "if": { "not": { "required": ["grader"] } },
          "then": { "required": ["assertion"] }
        },
        {
          "if": {
            "properties": { "grader": { "const": "command" } },
            "required": ["grader"]
          },
          "then": {
            "anyOf": [{ "required": ["assertion"] }, { "required": ["command"] }]
          }
        },
        {
          "if": {
            "properties": { "grader": { "const": "human" } },
            "required": ["grader"]
          },
          "then": { "required": ["assertion"] }
        },
        {
          "if": { "required": ["command"] },
          "then": {
            "properties": { "grader": { "const": "command" } },
            "required": ["grader"]
          }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["success-exit-codes"] },
              { "required": ["timeout-ms"] }
            ]
          },
          "then": {
            "properties": { "grader": { "const": "command" } },
            "required": ["grader"]
          }
        }
      ]
    },
    "anchorList": {
      "if": { "type": "array" },
      "then": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "else": { "type": "string", "minLength": 1 }
    },
    "suiteDef": {
      "type": "object",
      "properties": {
        "target-pass-rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "evals": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
