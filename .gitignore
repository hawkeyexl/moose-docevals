node_modules/
dist/
.moose-docevals/
*.tsbuildinfo
.DS_Store

# Scratch space for transient files. Keep them in the worktree, never in
# %TEMP% or /tmp — see "Testing behavior" in CLAUDE.md.
.tmp/

# Report written by the CI dogfood gate; also produced by a local dogfood run.
moose-docevals-run.json

# Doc Detective run output (see .doc-detective.json `output`). Written whenever
# the tool:doc-detective grader runs over the docs corpus.
# NOTE: docs/.moose-docevals-cache/ is deliberately NOT ignored — it holds the
# committed judge cache that lets verify-docs replay without an API key.
# See adrs/01004-test-the-docs-through-moose-docevals-itself.md.
.doc-detective/
